#!/usr/bin/env python3
# qubes-dispvm-fetch - fetch a URL or git repository in a disposable qube and
# bring the result into dom0 under ~/QubesIncoming/, safely.
#
# Run in dom0 as your normal user:
#   qubes-dispvm-fetch https://example.org/file.tar.gz
#   qubes-dispvm-fetch https://github.com/QubesOS/qubes-core-admin-client
#
# Trust model: everything coming out of the disposable is untrusted. dom0 never
# runs a tar/git/archive tool on it. The disposable sends a tar stream; this
# script parses it itself and accepts only plain files and directories with
# clean relative names, within size/count limits. It writes them fresh with
# fixed permissions (0644 / 0755, no exec, no setuid, ownership = you) and
# ignores all metadata from the archive. Output lands in a hidden staging dir
# and is only renamed into place if the whole transfer passed.
#
# SPDX-License-Identifier: MIT

import argparse
import hashlib
import os
import re
import resource
import secrets
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tarfile
import threading
import time
import unicodedata
import urllib.parse

VERSION = "1.1.2"

DEFAULT_MAX_BYTES = 2 * 1024**3        # total payload
DEFAULT_MAX_FILES = 100_000
MAX_DEPTH = 64
MAX_COMPONENT = 255
MAX_PATH = 4096
CHUNK = 1024 * 1024
MEMORY_LIMIT = 768 * 1024**2           # address-space cap for this process
MAX_STDERR_LINES = 500
MAX_STDERR_LINE = 4096


class Reject(Exception):
    """The transfer is refused; nothing is kept."""


# --------------------------------------------------------------- terminal-safe
def safe(text):
    """Render untrusted text harmless for a terminal (no escapes, no bidi tricks)."""
    if isinstance(text, bytes):
        text = text.decode("utf-8", "replace")
    out = []
    for ch in text:
        cat = unicodedata.category(ch)
        if ch == "\n" or ch == "\t":
            out.append(ch)
        elif cat in ("Cc", "Cf", "Cs", "Co", "Cn", "Zl", "Zp"):
            out.append("\\x%02x" % ord(ch) if ord(ch) < 256 else "\\u%04x" % ord(ch))
        else:
            out.append(ch)
    return "".join(out)


def info(msg):
    print(f"qubes-dispvm-fetch: {msg}", file=sys.stderr, flush=True)


def die(msg, code=1):
    info(f"error: {msg}")
    sys.exit(code)


# --------------------------------------------------------------- name checks
def check_member_name(raw):
    """Return a list of clean path components, or raise Reject."""
    if not isinstance(raw, str):
        raise Reject("non-text member name")
    name = raw
    while name.startswith("./"):
        name = name[2:]
    name = name.rstrip("/")
    if name in ("", "."):
        return []                                   # archive root
    if len(name.encode("utf-8")) > MAX_PATH:
        raise Reject(f"path too long: {safe(name[:80])}...")
    if name.startswith("/"):
        raise Reject(f"absolute path: {safe(name)}")
    parts = name.split("/")
    if len(parts) > MAX_DEPTH:
        raise Reject(f"path too deep: {safe(name[:80])}...")
    for p in parts:
        if p in ("", ".", ".."):
            raise Reject(f"bad path component in {safe(name)!r}")
        if len(p.encode("utf-8")) > MAX_COMPONENT:
            raise Reject(f"name too long: {safe(p[:80])}...")
        for ch in p:
            if unicodedata.category(ch) in ("Cc", "Cf", "Cs", "Co", "Cn", "Zl", "Zp"):
                raise Reject(f"control/format character in name: {safe(name)!r}")
    return parts


def slug(text, fallback="download"):
    s = re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip(".-")[:80]
    return s or fallback


# --------------------------------------------------------------- byte limiting
class LimitedReader:
    """Wraps the stream from the disposable; aborts once it exceeds `limit` bytes."""

    def __init__(self, raw, limit):
        self.raw, self.limit, self.count = raw, limit, 0

    def read(self, n=-1):
        if n is None or n < 0:
            n = CHUNK
        data = self.raw.read(min(n, CHUNK))
        self.count += len(data)
        if self.count > self.limit:
            raise Reject(f"stream exceeds {self.limit} bytes")
        return data


# --------------------------------------------------------------- extraction
def receive(stream, staging, max_bytes, max_files, keep_git=False):
    """Parse the tar stream from the disposable into `staging`. Returns (files, bytes, skipped).
    `max_files` limits every entry (files, directories, skipped links), not just files."""
    files = total = entries = 0
    skipped = []
    # Stream mode ('r|'): sequential, no seeking; strict UTF-8 names.
    with tarfile.open(fileobj=stream, mode="r|", encoding="utf-8", errors="strict") as tar:
        for m in tar:
            parts = check_member_name(m.name)
            if not parts:
                continue
            rel = "/".join(parts)
            entries += 1
            if entries > max_files:
                raise Reject(f"more than {max_files} entries")
            if not keep_git and any(p.lower() == ".git" for p in parts):
                # enforced here, not trusted to the disposable: an untrusted .git/config
                # can make later git commands in dom0 run arbitrary code
                skipped.append(rel + "  [.git dropped]")
                continue
            if m.issym() or m.islnk():
                skipped.append(rel)                 # links are never created
                continue
            if not (m.isreg() or m.isdir()):
                raise Reject(f"special file not allowed: {safe(rel)} (type {safe(m.type)})")

            parent = staging
            for p in parts[:-1]:                    # create parents ourselves
                parent = os.path.join(parent, p)
                ensure_dir(parent)
            target = os.path.join(staging, *parts)

            if m.isdir():
                ensure_dir(target)
                continue

            files += 1
            if m.size < 0 or total + m.size > max_bytes:
                raise Reject(f"payload exceeds {max_bytes} bytes")
            src = tar.extractfile(m)
            fd = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
            written = 0
            with os.fdopen(fd, "wb") as out:
                while True:
                    chunk = src.read(CHUNK)
                    if not chunk:
                        break
                    written += len(chunk)
                    if written > m.size:
                        raise Reject(f"member larger than declared: {safe(rel)}")
                    out.write(chunk)
            if written != m.size:
                raise Reject(f"truncated member: {safe(rel)}")
            total += written
    return files, total, skipped


def looks_like_html(path):
    """True if a downloaded file is a web page (error page, repo browser, login wall...)."""
    with open(path, "rb") as f:
        head = f.read(4096)
    head = head.lstrip(b"\xef\xbb\xbf").lstrip().lower()
    if not head.startswith(b"<"):
        return False
    return any(tag in head for tag in (b"<!doctype html", b"<html", b"<head", b"<body"))


def ensure_dir(path):
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        os.mkdir(path, 0o755)
        return
    if not stat.S_ISDIR(st.st_mode):
        raise Reject(f"path used as both file and directory: {safe(path)}")


# --------------------------------------------------------------- disposable side
def remote_script(url, mode, name, ref, keep_git, allow_http, max_bytes):
    """POSIX sh run inside the disposable. Only quoted values are interpolated."""
    q = shlex.quote
    protos_curl = "=https,http" if allow_http else "=https"
    git_protos = "-c protocol.allow=never -c protocol.https.allow=always"
    if allow_http:
        git_protos += " -c protocol.http.allow=always"
    branch = f"--branch {q(ref)}" if ref else ""
    git_fetch = (f"git {git_protos} -c core.symlinks=true clone --depth 1 --single-branch "
                 f"--no-tags {branch} -- {q(url)} out/{q(name)} >&2")
    if not keep_git:
        git_fetch += f"; rm -rf out/{q(name)}/.git"
    file_fetch = (f"curl --fail --location --silent --show-error --proto {q(protos_curl)} "
                  f"--proto-redir {q(protos_curl)} --max-filesize {int(max_bytes)} "
                  f"--retry 2 --connect-timeout 30 -o out/{q(name)} -- {q(url)} >&2")
    no_git = ("echo 'git is NOT installed in this disposable template, so git repositories "
              "cannot be cloned or detected (install git in the template)' >&2")
    if mode == "git":
        fetch = f"if ! command -v git >/dev/null 2>&1; then {no_git}; exit 127; fi; {git_fetch}"
    elif mode == "file":
        fetch = file_fetch
    else:
        # auto: a URL that answers the git protocol is cloned, anything else downloaded
        fetch = (f"if ! command -v git >/dev/null 2>&1; then {no_git}; {file_fetch}; else "
                 f"rc=0; timeout 120 git {git_protos} ls-remote -- {q(url)} >/dev/null 2>\"$W/probe\" || rc=$?; "
                 f"if [ $rc = 0 ]; then echo 'git repository detected, cloning' >&2; {git_fetch}; else "
                 f"if [ $rc = 124 ]; then echo 'git probe timed out after 120s' >&2; "
                 f"else echo \"git probe failed (exit $rc), not a git repository?\" >&2; fi; "
                 f"head -c 2000 \"$W/probe\" | head -n 3 >&2; "
                 f"echo 'downloading as a file' >&2; {file_fetch}; fi; fi")
    return (
        "set -eu; umask 022; "
        "export GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=/bin/false SSH_ASKPASS=/bin/false LC_ALL=C; "
        "W=$(mktemp -d \"$HOME/fetch.XXXXXX\"); cd \"$W\"; mkdir out; "
        f"{fetch}; "
        "tar --format=pax --numeric-owner --owner=0 --group=0 -C out -cf - ."
    )


def pump_stderr(pipe, sink):
    """Echo the disposable's stderr, escaped, with bounded line length and count."""
    lines = 0
    while True:
        line = pipe.readline(MAX_STDERR_LINE)
        if not line:
            break
        lines += 1
        if lines <= MAX_STDERR_LINES:
            sink.write("  [dispvm] " + safe(line.rstrip(b"\n")) + "\n")
            sink.flush()
        elif lines == MAX_STDERR_LINES + 1:
            sink.write("  [dispvm] ... further output suppressed\n")
            sink.flush()


def stop(proc):
    """Stop qvm-run so that it still destroys the disposable.
    qvm-run cleans up the disposable on normal exit or SIGINT, not on SIGKILL."""
    for sig, wait in ((signal.SIGINT, 20), (signal.SIGTERM, 5), (signal.SIGKILL, 5)):
        if proc.poll() is not None:
            return
        try:
            proc.send_signal(sig)
            proc.wait(timeout=wait)
        except subprocess.TimeoutExpired:
            continue
        except ProcessLookupError:
            return


def default_dispvm():
    try:
        r = subprocess.run(["qubes-prefs", "default_dispvm"], capture_output=True, text=True, check=True)
    except (OSError, subprocess.CalledProcessError) as e:
        die(f"cannot read default_dispvm (are you in dom0?): {e}")
    v = r.stdout.strip()
    if not v or v == "None":
        die("no default_dispvm set; use --dispvm TEMPLATE")
    return v


# --------------------------------------------------------------- main
def main():
    ap = argparse.ArgumentParser(
        prog="qubes-dispvm-fetch",
        description="Fetch a URL or git repo in a disposable qube and copy it safely "
                    "into dom0 ~/QubesIncoming/dispvm-fetch/.")
    ap.add_argument("url")
    kind = ap.add_mutually_exclusive_group()
    kind.add_argument("--git", action="store_true",
                      help="git clone (default: auto-detected, the disposable asks the URL for git refs first)")
    kind.add_argument("--file", action="store_true", help="plain download with curl, no git detection")
    ap.add_argument("--ref", help="git branch or tag to clone")
    ap.add_argument("--dispvm", metavar="TEMPLATE", help="disposable template (default: qubes-prefs default_dispvm)")
    ap.add_argument("--name", help="name for the result (default: derived from the URL)")
    ap.add_argument("--dest", default=os.path.expanduser("~/QubesIncoming/dispvm-fetch"),
                    help="parent directory (default: %(default)s)")
    ap.add_argument("--sha256", help="expected SHA-256 of the downloaded file (--file only), checked in dom0")
    ap.add_argument("--max-bytes", type=int, default=DEFAULT_MAX_BYTES, help="total size limit (default 2 GiB)")
    ap.add_argument("--max-files", type=int, default=DEFAULT_MAX_FILES, help="limit on entries: files, directories and links (default 100000)")
    ap.add_argument("--timeout", type=int, default=1800, help="seconds before the disposable is killed (default 1800)")
    ap.add_argument("--allow-http", action="store_true", help="also allow plain http (default: https only)")
    ap.add_argument("--keep-git", action="store_true",
                    help="keep the .git directory. DANGEROUS: untrusted .git/config can make git commands "
                         "you later run in that directory execute arbitrary code in dom0")
    ap.add_argument("--version", action="version", version=VERSION)
    a = ap.parse_args()

    if os.geteuid() == 0:
        die("run as your normal dom0 user, not root")

    u = urllib.parse.urlsplit(a.url)
    allowed = {"https", "http"} if a.allow_http else {"https"}
    if u.scheme not in allowed or not u.netloc:
        die(f"URL must be {' or '.join(sorted(allowed))}: {safe(a.url)}")
    if any(unicodedata.category(c).startswith("C") or c.isspace() for c in a.url):
        die("URL contains whitespace or control characters")
    if a.git or (not a.file and u.path.rstrip("/").endswith(".git")):
        mode = "git"
    elif a.file or a.sha256:
        mode = "file"
    else:
        mode = "auto"
    if a.sha256 and mode != "file":
        die("--sha256 only applies to file downloads")
    if a.sha256 and not re.fullmatch(r"[0-9a-fA-F]{64}", a.sha256):
        die("--sha256 must be 64 hex characters")
    if a.keep_git and mode == "file":
        die("--keep-git does not apply to file downloads")

    base = os.path.basename(u.path.rstrip("/"))
    if mode != "file" and base.endswith(".git"):
        base = base[:-4]
    name = slug(a.name or base or u.netloc)

    # destination root: a real directory owned by us
    dest = os.path.abspath(a.dest)
    os.makedirs(dest, mode=0o750, exist_ok=True)
    st = os.lstat(dest)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        die(f"{dest} is not a directory owned by you")

    dvm = a.dispvm or default_dispvm()
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.-]{0,30}", dvm):
        die(f"invalid qube name: {safe(dvm)}")

    staging = os.path.join(dest, f".incoming-{secrets.token_hex(6)}")
    os.mkdir(staging, 0o700)
    cmd = ["qvm-run", f"--dispvm={dvm}", "--pass-io", "--no-gui", "--no-filter-escape-chars",
           remote_script(a.url, mode, name, a.ref, a.keep_git, a.allow_http, a.max_bytes)]
    info(f"fetching ({mode}) in a disposable from {dvm}: {safe(a.url)}")

    # Cap our own memory: tarfile buffers whole pax/longname headers, so a hostile
    # stream could otherwise make dom0 allocate gigabytes. The child (qvm-run)
    # gets the original limit back.
    soft, hard = resource.getrlimit(resource.RLIMIT_AS)
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            preexec_fn=lambda: resource.setrlimit(resource.RLIMIT_AS, (soft, hard)))
    cap = MEMORY_LIMIT if hard == resource.RLIM_INFINITY else min(MEMORY_LIMIT, hard)
    resource.setrlimit(resource.RLIMIT_AS, (cap, hard))

    t_err = threading.Thread(target=pump_stderr, args=(proc.stderr, sys.stderr), daemon=True)
    t_err.start()
    timed_out = threading.Event()

    def on_timeout():
        timed_out.set()
        stop(proc)
    timer = threading.Timer(a.timeout, on_timeout) if a.timeout > 0 else None
    if timer:
        timer.daemon = True
        timer.start()

    def remote_failure():
        """If the disposable side failed, say so instead of blaming the archive."""
        if timed_out.is_set():
            return f"timed out after {a.timeout}s"
        try:
            rc = proc.wait(timeout=15)
        except subprocess.TimeoutExpired:
            return None
        return f"fetch failed in the disposable (exit {rc})" if rc else None

    ok = False
    try:
        # tar overhead: 512-byte header per member plus padding; allow generous slack
        limit = a.max_bytes + 1024 * (a.max_files + 16) + 10 * 1024 * 1024
        reader = LimitedReader(proc.stdout, limit)
        files, total, skipped = receive(reader, staging, a.max_bytes, a.max_files, a.keep_git)
        # after the end marker tar only pads (<= 10 KiB); anything more is refused
        trailing = 0
        while True:
            chunk = reader.read(CHUNK)
            if not chunk:
                break
            trailing += len(chunk)
            if trailing > 1024 * 1024:
                raise Reject("unexpected data after the end of the archive")
        rc = proc.wait()
        t_err.join(timeout=5)
        if timed_out.is_set():
            raise Reject(f"timed out after {a.timeout}s")
        if rc != 0:
            raise Reject(f"fetch failed in the disposable (exit {rc})")
        if files == 0:
            raise Reject("nothing was received")
        top = os.path.join(staging, name)
        if os.path.isfile(top) and not os.path.islink(top) and looks_like_html(top):
            raise Reject("the server returned an HTML page, not a file or a git repository "
                         "(see the [dispvm] lines above; use a direct download link, or --git for a repository)")

        if a.sha256:
            path = os.path.join(staging, name)
            h = hashlib.sha256()
            with open(path, "rb") as f:
                for chunk in iter(lambda: f.read(CHUNK), b""):
                    h.update(chunk)
            if h.hexdigest() != a.sha256.lower():
                raise Reject(f"SHA-256 mismatch: got {h.hexdigest()}")
            info("SHA-256 verified in dom0")

        stamp = time.strftime("%Y%m%d-%H%M%S")
        final = os.path.join(dest, f"{stamp}-{name}")
        n = 1
        while os.path.lexists(final):
            n += 1
            final = os.path.join(dest, f"{stamp}-{name}-{n}")
        os.chmod(staging, 0o755)
        os.rename(staging, final)
        ok = True
        if skipped:
            info(f"skipped {len(skipped)} link(s)/.git entries (never created in dom0):")
            for s_ in skipped[:20]:
                print("    " + safe(s_), file=sys.stderr)
            if len(skipped) > 20:
                print(f"    ... and {len(skipped) - 20} more", file=sys.stderr)
        info(f"received {files} file(s), {total} bytes")
        print(final)
    except Reject as e:
        info(f"REJECTED: {remote_failure() or e}" if timed_out.is_set() else f"REJECTED: {e}")
    except tarfile.TarError as e:
        info(f"REJECTED: {remote_failure() or 'malformed archive: ' + safe(str(e))}")
    except MemoryError:
        info("REJECTED: archive needs too much memory (oversized headers)")
    except UnicodeError:
        info("REJECTED: member name is not valid UTF-8")
    except OSError as e:
        info(f"REJECTED: {safe(str(e))}")
    finally:
        if timer:
            timer.cancel()
        stop(proc)
        if not ok:
            shutil.rmtree(staging, ignore_errors=True)
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
